{
  "name": "principal-engineer-accelerator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "workspaces": [
    "apps/portfolio"
  ],
  "scripts": {
    "dev": "npm run build -- --progress && node site/tooling/serve.ts",
    "preview": "node site/tooling/serve.ts",
    "build": "node site/tooling/build.ts",
    "lint": "eslint site/tooling site/test site/shared/assets/study.js site/shared/assets/search.js apps/portfolio/src",
    "format": "prettier --write \"**/*.{html,css,js,mjs,cjs,ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,cjs,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test site/test/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && node --test site/test/build-output.test.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
