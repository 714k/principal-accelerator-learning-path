{
  "name": "principal-engineer-accelerator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "workspaces": [
    "apps/book",
    "apps/portfolio"
  ],
  "scripts": {
    "dev": "npm run build && node apps/book/src/serve.ts",
    "preview": "node apps/book/src/serve.ts",
    "build": "node apps/book/src/build.ts",
    "lint": "eslint apps/book/src apps/book/test apps/portfolio/src",
    "typecheck": "tsc --noEmit",
    "test": "node --test apps/book/test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
